# TEMPLATE ONLY - this file IS committed to git.
#
# Never put real credentials here. Copy it to `.env` (which is gitignored)
# and put your real values in that copy instead:
#
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS / Linux)

# --- Server ---
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- MSSQL connection ---
# Run db/03_app_user.sql and connect as the least-privilege `lli_hr_app`
# login. Do not point the application at `sa`: that account is a
# server-wide sysadmin, while the API only needs read/write on three
# tables in a single database.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=LLI_HR_DB
DB_USER=lli_hr_app
DB_PASSWORD=the_password_you_set_in_03_app_user.sql

# Local dev uses a self-signed certificate, so the server cert is trusted.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# --- Authentication ---
# Must be at least 32 characters; the server refuses to start otherwise.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=8h
