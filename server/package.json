{
  "name": "lli-hr-server",
  "version": "1.0.0",
  "description": "RESTful API for the HR Employee Records Management System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:watch": "node --test --watch --test-concurrency=1 \"tests/**/*.test.js\""
