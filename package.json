{
  "name": "lli-hr-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "HR Employee Records Management System - React + Ant Design, Express, MSSQL",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "dev": "concurrently --names \"api,web\" --prefix-colors \"blue,magenta\" --kill-others \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start": "npm --prefix server start",
    "db:schema": "node scripts/run-sql.js db/01_schema.sql master",
    "db:seed": "node scripts/run-sql.js db/02_seed.sql LLI_HR_DB",
    "db:appuser": "node scripts/run-sql.js db/03_app_user.sql master",
    "db:migrate": "npm run db:migrate:governance && npm run db:migrate:search",
    "db:migrate:governance": "node scripts/run-sql.js db/04_governance.sql LLI_HR_DB",
    "db:migrate:search": "node scripts/run-sql.js db/05_search_indexes.sql LLI_HR_DB",
    "test": "npm --prefix server test",
    "lint": "npm --prefix client run lint",
    "build": "npm --prefix client run build",
    "check": "npm run lint && npm run build && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "license": "MIT"
}
